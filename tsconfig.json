{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  },
  "include": ["src/**/*.ts"]
}
